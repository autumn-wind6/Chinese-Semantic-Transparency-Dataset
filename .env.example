# 复制为 .env 后填写。不要把含真实密钥的 .env 提交到 Git。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# 若词汇结构评分使用同一密钥，可将 QWEN_STRUCTURE_API_KEY 留空。
QWEN_STRUCTURE_API_KEY=
QWEN_STRUCTURE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_STRUCTURE_MODEL=qwen3.5-397b-a17b

# 腾讯中文 Word2Vec 二进制文件保留在仓库外，在此填写本机绝对路径。
TENCENT_W2V_BIN=
